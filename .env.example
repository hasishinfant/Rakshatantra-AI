# RakshaTantra AI - Environment Configuration

# API Configuration
VITE_API_BASE_URL=https://api.rakshatantra.com
VITE_CAMERA_SERVICE_URL=https://camera-service.rakshatantra.com

# Environment
VITE_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_VOICE_ALERTS=true
VITE_ENABLE_MULTILINGUAL=true
VITE_ENABLE_GAMIFICATION=true

# Supported Languages
VITE_SUPPORTED_LANGUAGES=en,hi,kn

# Alert Configuration
VITE_ALERT_TIMEOUT=5000
VITE_ALERT_VOLUME=0.7

# Camera Configuration
VITE_CAMERA_FEED_INTERVAL=500
VITE_DETECTION_CONFIDENCE_THRESHOLD=0.7

# Credit System
VITE_INITIAL_CREDITS=100
VITE_CREDIT_INCREMENT_SAFE=5
VITE_CREDIT_DECREMENT_HELMET=10
VITE_CREDIT_DECREMENT_FATIGUE=15
VITE_CREDIT_DECREMENT_INACTIVITY=5

# Dashboard
VITE_MAX_WORKERS_DISPLAY=50
VITE_REFRESH_INTERVAL=1000

# Analytics
VITE_ENABLE_ANALYTICS=true
VITE_ANALYTICS_KEY=

# Monitoring
VITE_ENABLE_ERROR_TRACKING=true
VITE_ERROR_TRACKING_KEY=
